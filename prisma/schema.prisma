// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  idProducto Int  @id @default(autoincrement())
  nombre    String
  marcaId Int?
  marca Marca? @relation(fields: [marcaId], references: [idMarca])
  variantes Variante[]

}

model Venta {
  idVenta   Int             @id @default(autoincrement())
  fechaHora DateTime        @default(now())
  total     Int
  detalles   DetalleVenta[]
}

model DetalleVenta {
  id Int @id @default(autoincrement())
  cantidad Int
  precio Int
  ventaId Int
  venta Venta @relation(fields: [ventaId], references: [idVenta])
  loteId Int
  lote Lote @relation(fields: [loteId], references: [idLote])
}
model Proveedor {
  idProveedor Int      @id @default(autoincrement())
  nombre      String   // Mercado Morón
  lotes       Lote[]
}
model Lote {
  idLote           Int               @id @default(autoincrement())
  // Cantidades
  cantidadPacks    Int               // El "2" de la imagen
  unidadesPorPack  Int               // (Ej: 6 unidades por pack)
  cantidadInicial  Int               // Se calcula: packs * unidades
  cantidadActual   Int               
  
  // Costos y Descuentos (Entrada)
  costoPackBruto   Float             // $ 5.040
  descuentoPorc    Float?             // 0,40
  descuentoMonto   Float?             // $ 2.016
  costoIndividual  Float             // $ 1.512 (El costo real final)
  
  // Estado Financiero
  estadoPago       String            @default("PAGADO") // PAGADO / DEUDA
  observaciones    String?           // Columna "Detalle2" ($Real 2800)
  
  // Tiempos
  fechaIngreso     DateTime          @default(now())
  fechaVencimiento DateTime?

  // Relaciones
  idVariante       String
  variante         Variante          @relation(fields: [idVariante], references: [codigo], onDelete: Cascade)
  proveedorId      Int?
  proveedor        Proveedor?        @relation(fields: [proveedorId], references: [idProveedor])
  detalles         DetalleVenta[]
}
model Variante {
  codigo            String   @id @unique
  precioSugerido    Float    // $ 2.268
  precioVentaU      Float    // $ 3.000
  precioVentaPack   Float    // $ 6.000
  minimoParaReponer Int
  limiteCritico     Int
  estado            EstadoStock @default(ESTABLE)
  
  lotes             Lote[]
  productoId        Int
  producto          Producto @relation(fields: [productoId], references: [idProducto], onDelete: Cascade)
}
model Marca{
  idMarca Int @id  @default(autoincrement())
  nombre String
  productos Producto[]
  
}
// 5. Diccionario de Estados
enum EstadoPago {
  PAGADO
  DEUDA
}
enum EstadoStock {
  ESTABLE
  REPONER
  CRITICO
}
enum EstadoVencimiento {
  VIGENTE
  PROXIMO
  VENCIDO
}
enum EstadoVenta {
  EN_PROCESO
  CONFIRMADA
  CANCELADA
}
